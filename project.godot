; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotVRPong"
run/main_scene="uid://dpgwdj6kyi1sq"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Util="*res://game/singleton/util.gd"
Networking="*res://game/singleton/networking.gd"
Log="*res://addons/logger/logger.gd"
XR="*res://game/singleton/xr.gd"
XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"
Global="*res://game/singleton/global.gd"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/untyped_declaration=2

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/logger/plugin.cfg", "res://addons/sk_fly_camera/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=16
jolt_physics_3d/simulation/allow_sleep=false

[rendering]

textures/vram_compression/import_etc2_astc=true

[steam]

initialization/app_id=480
initialization/initialize_on_startup=false
initialization/embed_callbacks=false

[xr]

openxr/enabled=true
shaders/enabled=true
openxr/extensions/meta/color_space/starting_color_space=3
